# The Milestone 1 application remains in mock mode during Checkpoint 2B.1.
APP_ENV=local
APP_DATA_MODE=mock
APP_BASE_DOMAIN=ldchub.cn

# Server-only development and preview property context overrides.
DEV_PROPERTY_HOSTNAME=training-demo.example.test
PREVIEW_PROPERTY_HOSTNAME=training-preview.example.test

# Server-only Neon runtime configuration. Never prefix these with NEXT_PUBLIC_.
# Runtime must use hotel_ld_application on the explicitly verified endpoint.
DATABASE_URL=
NEON_ENDPOINT_ID=

# Server-only Better Auth service boundary. Never prefix either with NEXT_PUBLIC_.
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=

# Server-only Vercel Blob provider credential.
BLOB_READ_WRITE_TOKEN=
