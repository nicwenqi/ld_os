# Browser-safe Supabase configuration. Use the publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The Milestone 1 application remains in mock mode during Checkpoint 2B.1.
APP_ENV=local
APP_DATA_MODE=mock
APP_BASE_DOMAIN=ldchub.cn

# Server-only development and preview property context overrides.
DEV_PROPERTY_HOSTNAME=ktsz.ldchub.cn
PREVIEW_PROPERTY_HOSTNAME=
