{
  "version": 1,
  "modules": [
    { "order": 1, "path": "001_roles.sql" },
    { "order": 2, "path": "002_people.sql" },
    { "order": 3, "path": "003_actor_context.sql" }
  ],
  "schemas": ["app_private", "public"],
  "roles": ["hotel_ld_application", "hotel_ld_migration_owner"],
  "types": ["public.property_status"],
  "tables": ["public.properties"],
  "routines": ["app_private.install_actor_context", "app_private.touch_properties", "public.read_people"],
  "entrypoints": ["public.read_people"],
  "entrypointSignatures": ["public.read_people(text)"],
  "policies": ["properties_tenant_scope"],
  "triggers": ["properties_touch"],
  "exclusions": {
    "schemas": ["auth", "storage"],
    "objects": ["import", "history", "compatibility", "bridge", "reset"],
    "capabilities": ["seed data"]
  },
  "security": {
    "requireForceRls": true,
    "runtimeRole": "hotel_ld_application",
    "policyDescriptors": [
      {
        "schema": "public",
        "table": "properties",
        "name": "properties_tenant_scope",
        "command": "select",
        "roles": ["hotel_ld_migration_owner"],
        "permissive": true,
        "catalogUsing": "true",
        "catalogWithCheck": "",
        "using": "true",
        "withCheck": ""
      }
    ],
    "triggerDescriptors": [
      {
        "schema": "public",
        "table": "properties",
        "name": "properties_touch",
        "enabled": "origin",
        "timing": "before",
        "events": ["update"],
        "level": "row",
        "updateColumns": [],
        "function": "app_private.touch_properties()"
      }
    ],
    "runtimeSmokeExpectedRejections": {}
  }
}
